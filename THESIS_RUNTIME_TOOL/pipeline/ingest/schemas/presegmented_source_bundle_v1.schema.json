{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailab.local/schema/presegmented_source_bundle_v1.schema.json",
  "title": "Pre-segmented source bundle v1",
  "description": "Closed descriptor and component definitions for a source bundle whose block boundaries are already authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source_format",
    "source_file",
    "source_sha256",
    "source_utf8_bytes",
    "block_map_file",
    "block_map_sha256",
    "block_count",
    "chapter_count",
    "encoding",
    "line_endings",
    "text_policy",
    "marker_syntax"
  ],
  "properties": {
    "schema_version": { "const": "presegmented_source_bundle_v1" },
    "document_id": { "$ref": "#/$defs/id" },
    "source_format": {
      "type": "string",
      "enum": ["epub", "html", "markdown", "pdf", "txt"]
    },
    "source_file": { "$ref": "#/$defs/relative_path" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_utf8_bytes": { "type": "integer", "minimum": 1 },
    "block_map_file": { "$ref": "#/$defs/relative_path" },
    "block_map_sha256": { "$ref": "#/$defs/sha256" },
    "block_count": { "type": "integer", "minimum": 1 },
    "chapter_count": { "type": "integer", "minimum": 1 },
    "encoding": { "const": "UTF-8" },
    "line_endings": { "const": "LF" },
    "text_policy": { "const": "strip_outer_whitespace_v1" },
    "marker_syntax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "suffix"],
      "properties": {
        "prefix": { "const": "[[" },
        "suffix": { "const": "]]" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "marker": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "order_index", "title"],
      "properties": {
        "chapter_id": { "$ref": "#/$defs/id" },
        "order_index": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "block_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker",
        "block_id",
        "chapter_id",
        "order_index",
        "block_type",
        "source_sha256",
        "source_utf8_bytes"
      ],
      "properties": {
        "marker": { "$ref": "#/$defs/marker" },
        "block_id": { "$ref": "#/$defs/id" },
        "chapter_id": { "$ref": "#/$defs/id" },
        "order_index": { "type": "integer", "minimum": 0 },
        "block_type": {
          "type": "string",
          "enum": [
            "heading",
            "prose",
            "paragraph",
            "dialogue",
            "footnote",
            "code",
            "math",
            "math_block",
            "equation",
            "image",
            "table",
            "label",
            "raw_html",
            "list",
            "separator",
            "directive",
            "block_quote"
          ]
        },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_utf8_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "block_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "document_id", "chapters", "rows"],
      "properties": {
        "schema_version": { "const": "presegmented_block_map_v1" },
        "document_id": { "$ref": "#/$defs/id" },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chapter" }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block_row" }
        }
      }
    }
  }
}
